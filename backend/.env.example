# Copiar a .env: NO subir este archivo con contraseñas a Git.
DATABASE_URL=postgresql://tvm:CAMBIAR_PASSWORD@127.0.0.1:5432/tvm
PORT=3184
# false solo para pruebas HTTP locales. En dominio HTTPS usar true.
COOKIE_SECURE=false
# En producción completar con https://tvm.tudominio.com (sin barra final)
APP_ORIGIN=
MAX_UPLOAD_MB=250

# Publicaciones automáticas v0.3: el servidor revisa cada 10 segundos, sin opción de apagarlo desde la web.
# La zona horaria llega desde el navegador en formato ISO con zona explícita.

# Opcional: ruta a ffprobe.exe en Windows. Sin FFprobe se marca "Sin verificar".
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
# En el VPS, instalar FFmpeg y activar para impedir subidas sin inspección técnica:
REQUIRE_FFPROBE=false
# Para respaldo en Windows si pg_dump no está en PATH:
# PG_DUMP_PATH=C:/Program Files/PostgreSQL/17/bin/pg_dump.exe
